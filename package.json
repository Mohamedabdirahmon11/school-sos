{
  "name": "schoolos-multi-school-saas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env server.ts",
    "start": "tsx server.ts --production",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','server.js']) fs.rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test:security": "tsx --test tests/security.test.ts tests/security-http.test.ts tests/security-middleware.test.ts tests/superadmin-bootstrap-http.test.ts",
    "test:superadmin-auth": "tsx --test tests/superadmin-bootstrap-http.test.ts",
    "test:fees": "tsx --test tests/fees-http.test.ts",
    "test:payroll": "tsx --test --test-concurrency=1 tests/payroll-http.test.ts",
    "test:subscriptions": "tsx --test tests/subscription-lifecycle.test.ts",
    "test:academics": "tsx --test tests/academics-rules.test.ts",
    "test:pdf": "tsx --test tests/pdf.test.ts",
    "test:report-cards": "tsx --test tests/report-cards.test.ts",
    "test:admissions": "tsx --test tests/admissions-http.test.ts",
    "test:import": "tsx --test tests/import-http.test.ts",
    "test:storage": "tsx --test tests/storage-supabase.test.ts tests/no-json-runtime.test.ts",
    "test:schema": "tsx tests/schema-idempotency.test.ts",
    "audit:routes": "tsx scripts/check-route-parity.ts",
    "audit:rls": "tsx scripts/check-rls-source.ts",
    "audit:translations": "tsx scripts/audit-ui-strings.ts",
    "test:errors": "tsx --test tests/async-errors.test.ts",
    "test:middleware": "tsx --test tests/security-middleware.test.ts",
    "test:roles": "tsx --test tests/roles.test.ts",
    "test:dashboard": "tsx --test tests/dashboard-render.test.tsx",
    "test:schema-conformance": "tsx --test tests/schema-conformance.test.ts",
    "test": "tsx --test --test-concurrency=1 \"tests/*.test.ts\" \"tests/*.test.tsx\"",
    "typecheck:ci": "tsc --noEmit -p tsconfig.ci.json",
    "test:ci": "tsx --test --test-concurrency=1 tests/async-errors.test.ts tests/communication-http.test.ts tests/dashboard-render.test.tsx tests/no-json-runtime.test.ts tests/payroll-http.test.ts tests/pdf.test.ts tests/report-cards.test.ts tests/roles.test.ts tests/schema-conformance.test.ts tests/storage-performance.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
