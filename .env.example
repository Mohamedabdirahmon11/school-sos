SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Number of trusted reverse-proxy hops (1 for a single hosting proxy).
# Set this to the actual proxy chain length in production; do not trust arbitrary X-Forwarded-For values.
TRUST_PROXY_HOPS=1

# Password-reset email provider: set to `gmail` or `resend`.
MAIL_PROVIDER=resend

# Gmail SMTP (server-side only). Use a Google App Password, never your normal Gmail password.
# The authenticated Gmail address and the address inside MAIL_FROM must match.
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
# Example: SchoolOS <schoolos@example.com>
MAIL_FROM=

# Resend (used only when MAIL_PROVIDER=resend).
# Verify the sender domain with Resend before enabling delivery.
MAIL_PROVIDER_API_KEY=
