SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Number of trusted reverse-proxy hops (1 for a single hosting proxy).
# Set this to the actual proxy chain length in production; do not trust arbitrary X-Forwarded-For values.
TRUST_PROXY_HOPS=1

# Optional password-reset email delivery via Resend.
# Create a Resend API key and verify the sender domain before enabling real email delivery.
MAIL_PROVIDER_API_KEY=
# Must use the verified domain, e.g. SchoolOS <no-reply@your-verified-domain.com>.
# This is the FROM address; it is not the recipient's Gmail address.
MAIL_FROM=
