SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Number of trusted reverse-proxy hops (1 for a single hosting proxy).
# Set this to the actual proxy chain length in production; do not trust arbitrary X-Forwarded-For values.
TRUST_PROXY_HOPS=1

# Optional password-reset email delivery via Resend. Verify your sending domain first.
MAIL_PROVIDER_API_KEY=
# Sender must be a verified address/domain, e.g. SchoolOS <no-reply@example.com>
MAIL_FROM=
